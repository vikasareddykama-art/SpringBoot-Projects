          "raw": "{\n  \"passengerName\": \"Postman Tester Updated\",\n  \"busNumber\": \"PM-01-0001\",\n  \"source\": \"Mysore\",\n  \"destination\": \"Bangalore\",\n  \"travelDate\": \"{{futureDate}}\",\n  \"seatNumber\": {{seat}},\n  \"ticketFare\": 300.0\n}"
