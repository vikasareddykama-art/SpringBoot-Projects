{
  "info": {
    "name": "Bus Travel Booking Management System",
    "description": "Run the whole collection with the Collection Runner. Requests 1-15 run in order and clean up after themselves.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1/bus-bookings"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "seat",
      "value": ""
    },
    {
      "key": "futureDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Add booking (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passengerName\": \"Postman Tester\",\n  \"busNumber\": \"PM-01-0001\",\n  \"source\": \"Mysore\",\n  \"destination\": \"Bangalore\",\n  \"travelDate\": \"{{futureDate}}\",\n  \"seatNumber\": {{seat}},\n  \"ticketFare\": 275.5\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Future date (10 days ahead) and a seat number that changes on every run",
              "pm.collectionVariables.set('futureDate', new Date(Date.now() + 10*86400000).toISOString().slice(0,10));",
              "if (!pm.collectionVariables.get('seat')) { pm.collectionVariables.set('seat', (Date.now() % 50) + 1); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "var b = pm.response.json();",
              "pm.test('Booking ID generated', function () { pm.expect(b.bookingId).to.be.a('number'); });",
              "pm.collectionVariables.set('bookingId', b.bookingId);"
            ]
          }
        }
      ]
    },
